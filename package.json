{
  "name": "openclaw-nous-portal",
  "version": "1.1.1",
  "description": "Nous Portal provider plugin for OpenClaw with live model discovery.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "openclaw": ">=2026.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "openclaw": "2026.9.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jason-allen-oneal/openclaw-nous-portal.git"
  },
  "homepage": "https://github.com/jason-allen-oneal/openclaw-nous-portal#readme",
  "bugs": {
    "url": "https://github.com/jason-allen-oneal/openclaw-nous-portal/issues"
  },
  "keywords": [
    "openclaw",
    "plugin",
    "provider",
    "nous",
    "nous-research",
    "llm",
    "inference"
  ],
  "author": "Jason Allen O'Neal",
  "license": "MIT",
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "install": {
      "clawhubSpec": "clawhub:openclaw-nous-portal",
      "defaultChoice": "clawhub",
      "minHostVersion": ">=2026.9.1"
    },
    "compat": {
      "pluginApi": ">=2026.9.1"
    },
    "build": {
      "openclawVersion": "2026.9.1",
      "bundledDist": true
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": false
    }
  }
}
